{
  "name": "n8n-nodes-posta",
  "version": "0.2.5",
  "description": "n8n community node for the Posta social media management API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "social-media",
    "posta",
    "scheduling",
    "analytics"
  ],
  "license": "MIT",
  "homepage": "https://github.com/STGime/n8n-nodes-posta",
  "author": {
    "name": "Stefan Gimeson",
    "email": "stefan.gimeson@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/STGime/n8n-nodes-posta.git"
  },
  "engines": {
    "node": ">=18.0",
    "pnpm": ">=9.0"
  },
  "packageManager": "pnpm@9.15.0",
  "main": "dist/nodes/Posta/Posta.node.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts'",
    "lintfix": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts' --fix",
    "prepublishOnly": "pnpm build && pnpm lint",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PostaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Posta/Posta.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
